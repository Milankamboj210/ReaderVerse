<!DOCTYPE html>
<html lang="en">

<head>

    <%- include("partials/head") %>

</head>

<body>

    <%- include("partials/navbar") %>

    <main class="form-page">

        <section class="form-container">

            <h1>Edit Book</h1>

            <p>Update your reading experience.</p>

            <form action="/edit/<%= book.id %>" method="POST">

                <div class="form-group">

                    <label>ISBN</label>

                    <input
                        type="text"
                        name="isbn"
                        value="<%= book.isbn %>"
                        required
                    >

                </div>

                <div class="form-group">

                    <label>Book Title</label>

                    <input
                        type="text"
                        name="title"
                        value="<%= book.title %>"
                        required
                    >

                </div>

                <div class="form-group">

                    <label>Author</label>

                    <input
                        type="text"
                        name="author"
                        value="<%= book.author %>"
                        required
                    >

                </div>

                <div class="form-group">

                    <label>Rating</label>

                    <input
                        type="number"
                        name="rating"
                        min="0"
                        max="5"
                        step="0.1"
                        value="<%= book.rating %>"
                        required
                    >

                </div>

                <div class="form-group">

                    <label>Date Finished</label>

                    <input
                        type="date"
                        name="date_read"
                        value="<%= new Date(book.date_read).toISOString().split("T")[0] %>"
                        required
                    >

                </div>

                <div class="form-group">

                    <label>Review</label>

                    <textarea
                        name="review"
                        rows="6"
                        required
                    ><%= book.review %></textarea>

                </div>

                <div class="form-actions">

                    <a href="/books/<%= book.id %>" class="secondary-btn">

                        Cancel

                    </a>

                    <button
                        type="submit"
                        class="hero-btn"
                    >

                        Update Book

                    </button>

                </div>

            </form>

        </section>

    </main>

    <%- include("partials/footer") %>

</body>

</html>