<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("partials/head") %>
</head>

<body>

<header class="hero">
    <h1>Add a Book</h1>
    <p>Start building your personal reading universe.</p>
</header>

<main>

<section class="form-container">

<form action="/add" method="POST">

    <div class="form-group">
        <label>ISBN</label>
        <input
            type="text"
            name="isbn"
            placeholder="9781847941831"
            required
        >
    </div>

    <div class="form-group">
        <label>Title</label>
        <input
            type="text"
            name="title"
            placeholder="Atomic Habits"
            required
        >
    </div>

    <div class="form-group">
        <label>Author</label>
        <input
            type="text"
            name="author"
            placeholder="James Clear"
            required
        >
    </div>

    <div class="form-group">
        <label>Rating</label>
        <input
            type="number"
            name="rating"
            min="0"
            max="5"
            step="0.1"
            required
        >
    </div>

    <div class="form-group">
        <label>Date Finished</label>
        <input
            type="date"
            name="date_read"
        >
    </div>

    <div class="form-group">
        <label>My Thoughts</label>

        <textarea
            name="review"
            rows="8"
            placeholder="What made this book memorable?"
        ></textarea>

    </div>

    <button type="submit" class="primary-btn">
        Save Book
    </button>

</form>

</section>

</main>

<%- include("partials/footer") %>

</body>
</html>