<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ReaderVerse</title>
    <%- include("partials/head") %>
</head>

<body>

    <%- include("partials/navbar") %>

    <header class="hero">
    
        <h1>Your Reading Journey.</h1>
    
        <p>
    
            Organize, review and rediscover every book you've read.
    
        </p>
    
        <a href="/add" class="hero-btn">
    
            + Add New Book
    
        </a>
    
    </header>

    <main>

        <section class="dashboard">
            <%- include("partials/dashboard") %>
        </section>
        <section class="library-toolbar">

            <input
                type="text"
                placeholder="🔍 Search your library..."
            >
        
            <select>
        
                <option>
        
                    Sort by Latest
        
                </option>
        
                <option>
        
                    Highest Rated
        
                </option>
        
                <option>
        
                    Title (A-Z)
        
                </option>
        
            </select>
        
        </section>
        <section class="books-section">

            <h2>My Reading History</h2>

            <div class="book-grid">

                <% books.forEach((book) => { %>

                    <%- include("partials/bookCard", { book: book }) %>

                <% }) %>

            </div>

        </section>

    </main>

    <footer>
        <%- include("partials/footer") %>
    </footer>

</body>
</html>