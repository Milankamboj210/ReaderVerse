<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ReaderVerse</title>
    <%- include("partials/head") %>
</head>

<body>

    <%- include("partials/navbar") %>

    <header class="hero">
    
        <h1>Your Reading Journey.</h1>
    
        <p>
    
            Organize, review and rediscover every book you've read.
    
        </p>
    
        <a href="/add" class="hero-btn">
    
            + Add New Book
    
        </a>
    
    </header>

    <main>

        <section class="dashboard">
            <%- include("partials/dashboard") %>
        </section>
        <form action="/" method="GET" class="library-toolbar">

            <input
                type="text"
                name="search"
                placeholder="🔍 Search by title or author..."
                value="<%= search || '' %>"
            >
        
            <button type="submit" class="search-btn">
                Search
            </button>
        
        
            <select
            name="sort"
            class="sort-dropdown"
            onchange="this.form.submit()"
        >
            <option value="latest" <%= sort === "latest" ? "selected" : "" %>>
                📅 Sort by Latest
            </option>
        
            <option value="rating" <%= sort === "rating" ? "selected" : "" %>>
                ⭐ Highest Rated
            </option>
        
            <option value="title" <%= sort === "title" ? "selected" : "" %>>
                🔤 Title (A-Z)
            </option>
        </select>
    </form>
        </section>
        <section class="books-section">

            <h2>My Reading History</h2>

            <div class="book-grid">

                <% books.forEach((book) => { %>

                    <%- include("partials/bookCard", { book: book }) %>

                <% }) %>

            </div>

        </section>

    </main>

    <footer>
        <%- include("partials/footer") %>
    </footer>

</body>
</html>