<!DOCTYPE html>
<html lang="en">

<head>

    <%- include("partials/head") %>

</head>

<body>

<header class="hero">

    <h1>📚 ReaderVerse</h1>

    <p>Your Personal Reading Universe</p>

</header>

<main class="book-page">

    <div class="book-layout">

        <div class="book-cover-large">

            <% if(book.isbn){ %>

                <img
                    src="https://covers.openlibrary.org/b/isbn/<%= book.isbn %>-L.jpg"
                    alt="<%= book.title %>"
                >

            <% } else { %>

                <div class="cover-placeholder-large">

                    📚

                </div>

            <% } %>

        </div>

        <div class="book-details">

            <h1><%= book.title %></h1>

            <h3><%= book.author %></h3>

            <div class="book-info-row">

                <span class="rating">

                    ⭐ <%= book.rating %> / 5

                </span>

                <span class="badge">

                    <% if(book.rating == 5){ %>

                        👑 Favorite

                    <% } else if(book.rating >= 4.8){ %>

                        🏆 Masterpiece

                    <% } else if(book.rating >= 4.5){ %>

                        ⭐ Excellent

                    <% } else if(book.rating >= 4.0){ %>

                        👍 Great Read

                    <% } else { %>

                        📘 Good Read

                    <% } %>

                </span>

            </div>

            <p class="finished-date">

                <strong>Finished:</strong>

                <%= new Date(book.date_read).toLocaleDateString("en-GB",{
                    day:"2-digit",
                    month:"long",
                    year:"numeric"
                }) %>

            </p>

            <hr>

            <section class="review-section">

                <h2>My Thoughts</h2>

                <p>

                    <%= book.review %>

                </p>

            </section>

            <div class="book-actions">

                <a href="/edit/<%= book.id %>" class="edit-btn">
                    ✏️ Edit
                </a>
            
                <form action="/delete/<%= book.id %>" method="POST"
                      onsubmit="return confirm('Delete this book?')">
            
                    <button class="delete-btn">
                        🗑 Delete
                    </button>
            
                </form>
            
            </div>

        </div>

    </div>

</main>

<footer>

    <%- include("partials/footer") %>

</footer>

</body>

</html>