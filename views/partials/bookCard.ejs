<div class="book-card">

    <a href="/books/<%= book.id %>" class="book-cover">

        <% if (book.isbn) { %>

            <img
                src="https://covers.openlibrary.org/b/isbn/<%= book.isbn %>-L.jpg"
                alt="<%= book.title %>"
            >

        <% } else { %>

            <div class="cover-placeholder">

                📚

            </div>

        <% } %>

    </a>

    <div class="book-content">

        <h3 class="book-title"><%= book.title %></h3>

        <p class="book-author"><%= book.author %></p>

        <div class="rating-row">

            <span class="rating">

                ⭐ <%= book.rating %>

            </span>

            <span class="rating-badge">

                <% if (book.rating == 5) { %>

                    👑 Favorite

                <% } else if (book.rating >= 4.8) { %>

                    🏆 Masterpiece

                <% } else if (book.rating >= 4.5) { %>

                    ⭐ Excellent

                <% } else if (book.rating >= 4.0) { %>

                    👍 Great Read

                <% } else { %>

                    📘 Good Read

                <% } %>

            </span>

        </div>

    </div>

</div>